# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dsp

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=<replace-with-at-least-32-character-random-string>

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_EMBEDDING_DIMENSIONS=768

# NVD (optional — omitting works but requests are heavily rate-limited)
# Request a key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
